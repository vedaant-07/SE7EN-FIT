# Render backend environment variables
PORT=10000
NODE_ENV=production
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=https://se7en-fit-web.onrender.com

# Authentication security
AUTH_SECURITY_SECRET=
OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=https://se7en-fit-web.onrender.com/reset-password

# Transactional email
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=SE7EN FIT

# Gym-management website invitation acceptance URL.
# Example: https://your-gym-website.example/gym-management/staff/accept
STAFF_INVITATION_URL=

# Optional Google identity verification
GOOGLE_CLIENT_ID=

# Never expose service-role, authentication, Mailjet or payment secrets in VITE_* variables.